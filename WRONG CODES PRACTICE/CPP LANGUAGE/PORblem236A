#include <string>
#include <iostream>
using namespace std;
int main(){
    string l;
    cin >> l;
    int count =0;
    for(int i=0; i<l.size();i++){
        int j=0;
        for( j=0;j<l.size();j++){
            if(l[i]==l[j]){
                break;
            }
        }
        if(i==j){
            count++;
        }
    }
    if(count%2==0){
        cout <<"CHAT WITH HER!" <<endl;

    }
    else{
        cout<<"IGNORE HIM!"<<endl;
    }
    return 0;
}